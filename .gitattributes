# Normalize line endings: LF in the repo and in every working tree
# (Windows local + Linux cloud/CI) so diffs don't flip whole files.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.glb  binary
*.bin  binary
*.woff binary
*.woff2 binary
